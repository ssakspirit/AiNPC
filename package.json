{
  "name": "steve-ai-dashboard",
  "version": "1.0.0",
  "description": "마인크래프트 교육용 에디션과 연동되는 AI 교육용 대시보드",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run dev:frontend\" \"npm run dev:bridge\" --names \"FRONT,BRIDGE\" --prefix-colors \"cyan,magenta\"",
    "dev": "npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:bridge": "cd bridge && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:bridge": "cd bridge && npm run build:exe",
    "build": "npm run build:frontend && npm run build:bridge",
    "install:all": "npm install && cd frontend && npm install && cd ../bridge && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "minecraft",
    "education",
    "ai",
    "gemini",
    "dashboard"
  ],
  "author": "",
  "license": "MIT"
}
