{
  "name": "steve-ai-bridge",
  "version": "1.0.0",
  "type": "module",
  "description": "WebSocket bridge server for Minecraft Education Edition",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build:exe": "pkg . --output ../dist/steve-ai-bridge.exe"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "ws": "^8.16.0",
    "@google/generative-ai": "^0.2.0",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "../dist"
  }
}
